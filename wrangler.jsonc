{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "varna-cloudflare",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "vars": {
    "NODE_VERSION": "20"
  },
  "observability": {
    "enabled": true
  }
}
