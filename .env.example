# Varna Storefront - Cloudflare Deployment Environment Configuration
# Copy this file to .env.local for local development or set in Cloudflare Pages dashboard

# 1. MongoDB Atlas Configuration
# MongoDB connection string with connection pooling and server selection timeout
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/varna_store?retryWrites=true&w=majority"

# 2. Cloudinary Media Storage & CDN Configuration
# Used by /api/admin/upload for edge-signed direct uploads with automatic WebP conversion
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Alternative all-in-one URL format:
# CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# 3. Administrative Control Plane Security
# Master passcode fallback (default: varna2026)
ADMIN_PASSCODE="varna2026"
# Optional master secret key for programmatic API access
ADMIN_SECRET_KEY=""

# 4. Optional Site URL Override (Defaults automatically to request origin / Cloudflare assigned domain)
# PUBLIC_SITE_URL="https://your-project.pages.dev"
